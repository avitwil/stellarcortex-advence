<?xml version="1.0" encoding="utf-8"?>
<!-- No cleartext anywhere and no user-added CAs: server traffic is pinned in PinnedHttpPlugin. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
