{
  "name": "stellarcortex-advence",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** run build && pnpm -r --filter ./apps/** run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:brand": "node scripts/check-brand.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check": "pnpm typecheck && pnpm check:brand && pnpm check:licenses && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
